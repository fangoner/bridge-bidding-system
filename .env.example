# DeepSeek API 配置（必需）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 豆包视觉 API 配置（可选，用于图片识别功能）
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_VISION_ENDPOINT=your_vision_endpoint_here

# 豆包 Seed 2.1 Pro 模型推理接入点（可选，用于叫牌/打牌）
DOUBAO_SEED_2_1_PRO_CHAT_ENDPOINT=your_seed_2_1_pro_chat_endpoint_here
DOUBAO_SEED_2_1_PRO_REASONING_ENDPOINT=your_seed_2_1_pro_reasoning_endpoint_here

# 豆包 Seed 2.1 Turbo 模型推理接入点（可选，轻量模型）
DOUBAO_SEED_2_1_TURBO_CHAT_ENDPOINT=your_seed_2_1_turbo_chat_endpoint_here
DOUBAO_SEED_2_1_TURBO_REASONING_ENDPOINT=your_seed_2_1_turbo_reasoning_endpoint_here
