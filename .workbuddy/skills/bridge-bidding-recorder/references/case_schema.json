{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bridge Bidding Case",
  "description": "Schema for recorded bridge bidding discussion cases",
  "type": "object",
  "required": ["id", "date", "timestamp"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^case-[0-9]{3}$",
      "description": "Unique case identifier (e.g., case-001)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of the discussion (YYYY-MM-DD)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of recording"
    },
    "hand": {
      "type": "object",
      "description": "The hand being discussed",
      "properties": {
        "spades": {
          "type": "string",
          "description": "Spade holding (e.g., 'AKxx')"
        },
        "hearts": {
          "type": "string",
          "description": "Heart holding"
        },
        "diamonds": {
          "type": "string",
          "description": "Diamond holding"
        },
        "clubs": {
          "type": "string",
          "description": "Club holding"
        },
        "hcp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 37,
          "description": "High card points"
        }
      }
    },
    "position": {
      "type": "object",
      "description": "Table position and vulnerability",
      "properties": {
        "dealer": {
          "type": "string",
          "enum": ["North", "East", "South", "West"]
        },
        "vulnerability": {
          "type": "string",
          "enum": ["None", "NS", "EW", "Both"]
        },
        "seat": {
          "type": "string",
          "enum": ["North", "East", "South", "West"],
          "description": "Position of the hand being discussed"
        }
      }
    },
    "bidding_sequence": {
      "type": "array",
      "description": "Complete auction up to the decision point",
      "items": {
        "type": "string"
      }
    },
    "llm_bid": {
      "type": "string",
      "description": "The bid made by the AI"
    },
    "correct_bid": {
      "type": "string",
      "description": "The correct bid according to discussion"
    },
    "discussion_summary": {
      "type": "string",
      "description": "Brief summary of the discussion conclusion (1-2 sentences)"
    },
    "discussion_content": {
      "type": "string",
      "description": "Full discussion content or detailed analysis (can be lengthy)"
    },
    "tags": {
      "type": "array",
      "description": "Categories for retrieval",
      "items": {
        "type": "string"
      }
    },
    "convention": {
      "type": "string",
      "description": "Bidding convention system (e.g., 'JF', 'Standard American')"
    },
    "source": {
      "type": "string",
      "description": "Origin of the case (e.g., 'user discussion', 'record review')"
    }
  }
}
